---
import Layout from "../layouts/Layout.astro";
import { games } from "../data/games";
---

<Layout title="Games" description="Games shipped by Tobias Hieta — build, toolchain, and engine work credited on Assassin's Creed titles.">
  <section class="mx-auto max-w-3xl px-6 pt-16 pb-10">
    <p class="text-sm font-medium tracking-wide uppercase text-[var(--color-accent)]">Games</p>
    <h1 class="mt-3 text-3xl md:text-4xl font-semibold tracking-tight">Games shipped</h1>
    <p class="mt-4 text-[var(--color-muted)] leading-relaxed">
      Credited work on shipped titles. See the full credit list on
      <a class="text-[var(--color-accent)] hover:underline" href="https://www.mobygames.com/person/1815258/tobias-hieta/" target="_blank" rel="noopener">MobyGames</a>.
    </p>
  </section>

  <section class="mx-auto max-w-3xl px-6 pb-20 space-y-8">
    {
      games.map((game) => (
        <article class="border border-[var(--color-line)] rounded-lg p-6 flex flex-col sm:flex-row gap-6">
          <div class="shrink-0 w-full sm:w-32">
            <div class="aspect-[3/4] w-full sm:w-32 rounded-md bg-[var(--color-paper-soft)] border border-[var(--color-line)] flex items-center justify-center overflow-hidden">
              <img
                src={game.boxArt}
                alt={`${game.title} box art`}
                class="w-full h-full object-cover"
                onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
              />
              <span class="hidden text-xs text-[var(--color-muted)] text-center px-2">Box art coming soon</span>
            </div>
          </div>
          <div class="flex-1">
            <p class="text-xs uppercase tracking-wide text-[var(--color-muted)]">
              {game.year} · {game.role}
            </p>
            <h2 class="mt-1 text-xl font-medium">{game.title}</h2>
            <p class="mt-3 text-sm text-[var(--color-muted)] leading-relaxed">
              {game.description && game.description.length > 0
                ? game.description
                : "Description coming soon."}
            </p>
          </div>
        </article>
      ))
    }
  </section>
</Layout>
