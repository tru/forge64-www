---
import Layout from "../layouts/Layout.astro";
import { games } from "../data/games";
---

<Layout title="Games" description="Games shipped by Tobias Hieta — build, toolchain, and engine work credited on Assassin's Creed titles.">
  <section class="mx-auto max-w-3xl px-6 pt-16 pb-10">
    <p class="text-sm font-medium tracking-wide uppercase text-[var(--color-accent)]">Games</p>
    <h1 class="mt-3 text-3xl md:text-4xl font-semibold tracking-tight">Games shipped</h1>
    <p class="mt-4 text-[var(--color-muted)] leading-relaxed">
      Credited work on shipped titles. See the full credit list on
      <a class="text-[var(--color-accent)] hover:underline" href="https://www.mobygames.com/person/1815258/tobias-hieta/" target="_blank" rel="noopener">MobyGames</a>.
    </p>
  </section>

  <section class="mx-auto max-w-3xl px-6 pb-20 space-y-10">
    {
      games.map((game) => (
        <article class="border border-[var(--color-line)] rounded-lg overflow-hidden">
          <img src={game.boxArt} alt={`${game.title} key art`} class="w-full aspect-[616/353] object-cover" loading="lazy" />
          <div class="p-6">
            <p class="text-xs uppercase tracking-wide text-[var(--color-muted)]">
              {game.year} · {game.role}
            </p>
            <div class="mt-1 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <h2 class="text-xl font-medium">{game.title}</h2>
              <a
                href={game.trailerUrl}
                target="_blank"
                rel="noopener"
                class="text-sm text-[var(--color-accent)] hover:underline whitespace-nowrap"
              >
                Watch trailer ↗
              </a>
            </div>
            <p class="mt-3 text-sm text-[var(--color-muted)] leading-relaxed">{game.description}</p>
            <p class="mt-4 text-sm font-medium">What I worked on</p>
            <ul class="mt-2 space-y-1.5 text-sm">
              {game.highlights.map((point) => (
                <li class="flex gap-2">
                  <span class="text-[var(--color-accent)]">—</span>
                  <span>{point}</span>
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))
    }
  </section>
</Layout>
