---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact" description="Contact Forge64 Consulting AB and company details.">
  <section class="mx-auto max-w-3xl px-6 pt-16 pb-20">
    <p class="text-sm font-medium tracking-wide uppercase text-[var(--color-accent)]">Contact</p>
    <h1 class="mt-3 text-3xl md:text-4xl font-semibold tracking-tight">Get in touch</h1>
    <p class="mt-4 text-[var(--color-muted)] leading-relaxed max-w-xl">
      For consulting requests around toolchains, compilers, or build systems, reach out to
      <a class="text-[var(--color-accent)] hover:underline" href="mailto:info@forge64.se">info@forge64.se</a>.
    </p>

    <div class="mt-12 grid gap-10 sm:grid-cols-2">
      <div>
        <h2 class="font-medium">Company details</h2>
        <address class="not-italic mt-3 text-sm text-[var(--color-muted)] leading-relaxed">
          Forge64 Consulting AB<br />
          c/o Dospace<br />
          Drottninggatan 18<br />
          806 30 Gävle<br />
          Sweden
        </address>
        <p class="mt-3 text-sm text-[var(--color-muted)]">Org. number: 559555-6522</p>
        <p class="text-sm text-[var(--color-muted)]">EU VAT number: SE559555652201</p>
      </div>
      <div>
        <h2 class="font-medium">Elsewhere</h2>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a class="text-[var(--color-accent)] hover:underline" href="https://www.linkedin.com/in/tobiashieta" target="_blank" rel="noopener">LinkedIn</a></li>
          <li><a class="text-[var(--color-accent)] hover:underline" href="https://github.com/tru" target="_blank" rel="noopener">GitHub</a></li>
          <li><a class="text-[var(--color-accent)] hover:underline" href="https://tobias.hieta.se/" target="_blank" rel="noopener">Blog</a></li>
        </ul>
      </div>
    </div>
  </section>
</Layout>
