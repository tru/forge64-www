---
import Layout from "../layouts/Layout.astro";
import { videos, youtubeChannelUrl } from "../data/videos";

function youtubeId(url: string) {
  const match = url.match(/(?:youtu\.be\/|v=)([\w-]{6,})/);
  return match ? match[1] : "";
}
---

<Layout title="Talks & Videos" description="Conference talks and videos from Tobias Hieta on LLVM, Clang, and C++ build systems.">
  <section class="mx-auto max-w-5xl px-6 pt-16 pb-10">
    <p class="text-sm font-medium tracking-wide uppercase text-[var(--color-accent)]">Talks & Videos</p>
    <h1 class="mt-3 text-3xl md:text-4xl font-semibold tracking-tight">Conference talks & videos</h1>
    <p class="mt-4 text-[var(--color-muted)] leading-relaxed max-w-2xl">
      Talks on LLVM, Clang, and build systems from EuroLLVM and elsewhere.
      {youtubeChannelUrl && (
        <>
          More on the <a class="text-[var(--color-accent)] hover:underline" href={youtubeChannelUrl} target="_blank" rel="noopener">YouTube channel</a>.
        </>
      )}
    </p>
  </section>

  <section class="mx-auto max-w-5xl px-6 pb-20 grid gap-8 sm:grid-cols-2">
    {
      videos.map((video) => (
        <a href={video.url} target="_blank" rel="noopener" class="group block">
          <div class="aspect-video w-full rounded-md overflow-hidden bg-[var(--color-paper-soft)] border border-[var(--color-line)]">
            <img
              src={`https://i.ytimg.com/vi/${youtubeId(video.url)}/hqdefault.jpg`}
              alt={video.title}
              class="w-full h-full object-cover group-hover:opacity-90 transition-opacity"
              loading="lazy"
            />
          </div>
          <p class="mt-3 font-medium group-hover:text-[var(--color-accent)] transition-colors">{video.title}</p>
          {video.venue && <p class="text-sm text-[var(--color-muted)]">{video.venue}</p>}
        </a>
      ))
    }
  </section>
</Layout>
