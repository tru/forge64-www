---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Forge64 Consulting AB — toolchains, compilers and build systems for teams shipping high-performance C++ software and games.",
} = Astro.props;

const nav = [
  { href: "/", label: "Home" },
  { href: "/about/", label: "About" },
  { href: "/work/", label: "Work" },
  { href: "/games/", label: "Games" },
  { href: "/videos/", label: "Talks" },
  { href: "/contact/", label: "Contact" },
];

const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Forge64 Consulting AB</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="min-h-screen flex flex-col font-sans antialiased">
    <header class="border-b border-[var(--color-line)]">
      <div class="mx-auto max-w-5xl px-6 py-5 flex items-center justify-between gap-6">
        <a href="/" class="font-semibold tracking-tight text-lg">
          Forge<span class="text-[var(--color-accent)]">64</span>
        </a>
        <nav class="flex flex-wrap gap-x-5 gap-y-2 text-sm">
          {
            nav.map((item) => (
              <a
                href={item.href}
                class:list={[
                  "transition-colors hover:text-[var(--color-accent)]",
                  path === item.href ||
                  (item.href !== "/" && path.startsWith(item.href))
                    ? "text-[var(--color-accent)] font-medium"
                    : "text-[var(--color-muted)]",
                ]}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-[var(--color-line)] mt-20">
      <div class="mx-auto max-w-5xl px-6 py-10 flex flex-col md:flex-row md:items-start md:justify-between gap-8 text-sm text-[var(--color-muted)]">
        <div>
          <p class="font-medium text-[var(--color-ink)]">Forge64 Consulting AB</p>
          <p class="mt-1">c/o Dospace, Drottninggatan 18</p>
          <p>806 30 Gävle, Sweden</p>
          <p class="mt-1">Org. number: 559555-6522</p>
          <p>EU VAT number: SE559555652201</p>
        </div>
        <div>
          <p class="font-medium text-[var(--color-ink)]">Get in touch</p>
          <p class="mt-1">
            <a class="hover:text-[var(--color-accent)]" href="mailto:info@forge64.se">info@forge64.se</a>
          </p>
          <p class="mt-3 flex gap-4">
            <a class="hover:text-[var(--color-accent)]" href="https://www.linkedin.com/in/tobiashieta" target="_blank" rel="noopener">LinkedIn</a>
            <a class="hover:text-[var(--color-accent)]" href="https://github.com/tru" target="_blank" rel="noopener">GitHub</a>
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
